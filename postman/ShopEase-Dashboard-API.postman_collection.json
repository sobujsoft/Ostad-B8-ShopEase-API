{
	"info": {
		"name": "ShopEase - Dashboard API",
		"description": "Dashboard statistics API for ShopEase E-commerce admin panel.\n\n**Base URL:** `{{base_url}}/api/v1`\n\n**Authentication:** Requires Bearer token (Sanctum). Use the Login request first.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.token) {",
									"    pm.collectionVariables.set('token', jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@shopease.com\",\n    \"password\": \"password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/login",
							"host": ["{{base_url}}"],
							"path": ["api", "login"]
						},
						"description": "Login to get the auth token. The token is automatically saved to the `token` collection variable."
					},
					"response": []
				}
			]
		},
		{
			"name": "Dashboard",
			"item": [
				{
					"name": "Get Dashboard Data",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/dashboard",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "dashboard"]
						},
						"description": "Returns all dashboard data in a single response:\n\n**stats** — Stat cards with month-over-month % change:\n- `total_revenue` (from paid orders)\n- `total_orders`\n- `total_products`\n- `total_customers`\n\n**recent_orders** — Last 5 orders (order_number, customer_name, total, status)\n\n**top_categories** — Top 5 categories by active product count with percentage"
					},
					"response": []
				}
			]
		}
	]
}

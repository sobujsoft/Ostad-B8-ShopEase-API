{
	"info": {
		"name": "ShopEase - Order API",
		"description": "Order management API endpoints for ShopEase E-commerce application.\n\n**Base URL:** `{{base_url}}/api/v1`\n\n**Authentication:** All order management endpoints require Bearer token (Sanctum). Use the Login request first to auto-save token in the `token` collection variable.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "order_id",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.token) {",
									"    pm.collectionVariables.set('token', jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@shopease.com\",\n    \"password\": \"password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/login",
							"host": ["{{base_url}}"],
							"path": ["api", "login"]
						},
						"description": "Login to get the auth token. The token is automatically saved to the `token` collection variable."
					},
					"response": []
				}
			]
		},
		{
			"name": "Orders",
			"item": [
				{
					"name": "List Orders (Table View)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/orders?page=1&per_page=10&status=pending&search=ORD&from_date=2026-03-01&to_date=2026-03-31",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "orders"],
							"query": [
								{
									"key": "page",
									"value": "1",
									"description": "Page number for pagination"
								},
								{
									"key": "per_page",
									"value": "10",
									"description": "Items per page"
								},
								{
									"key": "status",
									"value": "pending",
									"description": "Optional status filter"
								},
								{
									"key": "search",
									"value": "ORD",
									"description": "Optional search by order number/customer name/customer email"
								},
								{
									"key": "from_date",
									"value": "2026-03-01",
									"description": "Optional start date (YYYY-MM-DD)"
								},
								{
									"key": "to_date",
									"value": "2026-03-31",
									"description": "Optional end date (YYYY-MM-DD)"
								}
							]
						},
						"description": "Get paginated order list for admin table view. Supports status, search, date range, and per-page filters."
					},
					"response": []
				},
				{
					"name": "Show Order Details",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/orders/{{order_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "orders", "{{order_id}}"]
						},
						"description": "Get order details by ID including items, status logs, item_total, and totals breakdown."
					},
					"response": []
				},
				{
					"name": "Update Order Status",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"confirmed\",\n    \"note\": \"Confirmed by admin after phone verification.\",\n    \"admin_notes\": \"Customer requested evening delivery.\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/orders/{{order_id}}/status",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "orders", "{{order_id}}", "status"]
						},
						"description": "Update order status and write status-change log. Valid statuses: pending, confirmed, processing, shipped, delivered, cancelled."
					},
					"response": []
				}
			]
		}
	]
}

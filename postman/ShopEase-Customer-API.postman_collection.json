{
	"info": {
		"name": "ShopEase - Customer API",
		"description": "Customer management API endpoints for ShopEase E-commerce admin panel.\n\n**Base URL:** `{{base_url}}/api/v1`\n\n**Authentication:** All endpoints require Bearer token (Sanctum). Use the Login request first.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "customer_id",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.token) {",
									"    pm.collectionVariables.set('token', jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@shopease.com\",\n    \"password\": \"password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/login",
							"host": ["{{base_url}}"],
							"path": ["api", "login"]
						},
						"description": "Login to get the auth token. The token is automatically saved to the `token` collection variable."
					},
					"response": []
				}
			]
		},
		{
			"name": "Customers",
			"item": [
				{
					"name": "List Customers",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/customers?page=1&per_page=10",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "customers"],
							"query": [
								{
									"key": "page",
									"value": "1",
									"description": "Page number"
								},
								{
									"key": "per_page",
									"value": "10",
									"description": "Items per page (default 10)"
								}
							]
						},
						"description": "Get a paginated list of all customers with their linked user info."
					},
					"response": []
				},
				{
					"name": "Search Customers",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/customers?search=john",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "customers"],
							"query": [
								{
									"key": "search",
									"value": "john",
									"description": "Search by name, email, or phone"
								}
							]
						},
						"description": "Search customers by name, email, or phone."
					},
					"response": []
				},
				{
					"name": "Filter by Status",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/customers?is_active=true",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "customers"],
							"query": [
								{
									"key": "is_active",
									"value": "true",
									"description": "Filter by active status (true/false)"
								}
							]
						},
						"description": "Filter customers by active/inactive status."
					},
					"response": []
				},
				{
					"name": "Show Customer",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/customers/{{customer_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "customers", "{{customer_id}}"]
						},
						"description": "Get customer details by ID. Includes user info and order stats (total_orders, total_spent, last_order_at)."
					},
					"response": []
				},
				{
					"name": "Toggle Active Status",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/customers/{{customer_id}}/toggle-active",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "customers", "{{customer_id}}", "toggle-active"]
						},
						"description": "Toggle customer active/inactive status. Also syncs the linked user account status."
					},
					"response": []
				},
				{
					"name": "Delete Customer",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/customers/{{customer_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "customers", "{{customer_id}}"]
						},
						"description": "Soft delete a customer. Also deactivates their linked user account."
					},
					"response": []
				}
			]
		}
	]
}
